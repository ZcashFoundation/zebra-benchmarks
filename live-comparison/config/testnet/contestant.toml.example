# Python 3.11+; copy this file and replace every /path/to path and build version.
# Each node requires its own already-synced state and unique RPC/P2P ports.
# Keep feeder P2P enabled; contestants use the isolated node examples in config/.
# Cookie paths refer to files generated by your nodes, not bundled credentials.
# Reference source: https://github.com/ZcashFoundation/zebra/tree/e8db87eb69254e0d4eedd058eadd48bdfa09065a
# Candidate source: https://github.com/ZcashFoundation/zebra/tree/89390f741931b5238a8ef94a86810d89b3320f1b
# Zakura source: https://github.com/zakura-core/zakura/tree/c572f8faf88e58dcaefd80ec8e4ed05f2d8643b6
poll_interval_seconds = 0.02
rpc_timeout_seconds = 10
sample_interval_seconds = 30
template_timeout_seconds = 5
pause_threshold_seconds = 2

[feeder]
url = "http://127.0.0.1:18332"
cookie = "/path/to/live-comparison/testnet/feeder/rpc/.cookie"
# Alternatively set auth to your own username:password; never configure both.

[[contestants]]
name = "zebra-reference"
client = "Zebra"
version = "SET_TO_EXACT_REFERENCE_BUILD"
url = "http://127.0.0.1:28332"
cookie = "/path/to/live-comparison/testnet/zebra-reference/rpc/.cookie"
# pid = 12345  # Optional local process sampling; replace after every node restart.

[[contestants]]
name = "zebra-candidate"
client = "Zebra"
version = "SET_TO_EXACT_CANDIDATE_BUILD"
url = "http://127.0.0.1:28342"
cookie = "/path/to/live-comparison/testnet/zebra-candidate/rpc/.cookie"
# pid = 12345  # Optional local process sampling; replace after every node restart.

[[contestants]]
name = "zakura"
client = "Zakura"
version = "SET_TO_EXACT_ZAKURA_BUILD"
url = "http://127.0.0.1:29332"
cookie = "/path/to/live-comparison/testnet/zakura/rpc/.cookie"
# pid = 12345  # Optional local process sampling; replace after every node restart.
