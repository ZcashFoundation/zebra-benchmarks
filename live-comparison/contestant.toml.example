# Python 3.11+; copy to the dispatcher host and replace every /path/to path, example IP and build version.
# One independently synced Mainnet machine per contestant, plus separate feeder and dispatcher machines.
# Cookies are fresh copies on the dispatcher; keep the node's P2P and RPC ports firewalled to it.
# With mirror_mempool = false, remove each p2p field and start with empty contestant mempools.
# Reference source: https://github.com/ZcashFoundation/zebra/tree/e8db87eb69254e0d4eedd058eadd48bdfa09065a
# Candidate source: https://github.com/ZcashFoundation/zebra/tree/89390f741931b5238a8ef94a86810d89b3320f1b
# Zakura v1.8.1 source: https://github.com/zakura-core/zakura/tree/f5c20398c629c8179364b07f059da3c814af78ec
poll_interval_seconds = 0.02
rpc_timeout_seconds = 10
sample_interval_seconds = 30
template_timeout_seconds = 5
pause_threshold_seconds = 2
mirror_mempool = true
measure_submit_paths = true
mempool_poll_seconds = 0.25
network = "mainnet"

[feeder]
url = "http://10.0.0.10:18232"
cookie = "/path/to/dispatcher/cookies/feeder.cookie"
# Alternatively set auth to your own username:password; never configure both.

[[contestants]]
name = "zebra-reference"
client = "Zebra"
version = "SET_TO_EXACT_REFERENCE_BUILD"
url = "http://10.0.0.11:28232"
cookie = "/path/to/dispatcher/cookies/zebra-reference.cookie"
p2p = "10.0.0.11:28233"
# pid = 12345  # Local-only /proc sampling; omit for remote contestants.

[[contestants]]
name = "zebra-candidate"
client = "Zebra"
version = "SET_TO_EXACT_CANDIDATE_BUILD"
url = "http://10.0.0.12:28242"
cookie = "/path/to/dispatcher/cookies/zebra-candidate.cookie"
p2p = "10.0.0.12:28243"
# pid = 12345  # Local-only /proc sampling; omit for remote contestants.

[[contestants]]
name = "zakura"
client = "Zakura"
version = "SET_TO_EXACT_ZAKURA_BUILD"
url = "http://10.0.0.13:29232"
cookie = "/path/to/dispatcher/cookies/zakura.cookie"
p2p = "10.0.0.13:29233"
# pid = 12345  # Local-only /proc sampling; omit for remote contestants.
